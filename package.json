{
  "name": "@preprocess-cn/nano-code-web",
  "version": "0.1.1",
  "description": "Web-based display plugin for nano-code",
  "type": "module",
  "main": "dist/display.js",
  "scripts": {
    "build": "tsc && cp public/index.html dist/index.html && cp public/app.js dist/app.js && cp public/dialog.js dist/dialog.js && cp public/style.css dist/style.css && node scripts/copy-vendor.mjs",
    "dev": "tsc --watch",
    "test": "tsx --test --test-force-exit tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright": "^1.61.1",
    "tsx": "^4.22.5",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0"
  }
}
